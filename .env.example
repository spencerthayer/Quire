# ==============================================================================
# Quire Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local overrides, or set these variables in your
# Docker Compose / Portainer stack configuration.
#
# Precedence order:
#   1. Environment variables (highest priority; overrides database settings)
#   2. SQLite settings table (editable through the web interface)
#   3. Built-in application defaults (lowest priority)
#
# Never commit populated .env files or real secrets to version control.
# ==============================================================================

# --- Application (Implemented in Phase 1) ---
QUIRE_HOST=0.0.0.0
QUIRE_PORT=8080
QUIRE_LOG_LEVEL=info

# --- Storage (Implemented in Phase 1) ---
QUIRE_DATA_DIR=/data
QUIRE_DATABASE_URL=sqlite:///data/quire.db

# --- Application Behavior (Implemented in Phase 1) ---
# When set in the environment, QUIRE_TIMEZONE locks the timezone setting in the
# browser UI so it cannot be overridden there. Leave unset to allow changing it
# through the Settings page.
QUIRE_TIMEZONE=America/Los_Angeles

# --- Future AI Integration (Reserved for Phase 4; optional, not required to start) ---
QUIRE_AI_PROVIDER=
QUIRE_AI_BASE_URL=
QUIRE_AI_MODEL=
QUIRE_AI_API_KEY=

# --- Future ElevenReader Integration (Reserved for Phase 6; optional, not required to start) ---
QUIRE_ELEVENREADER_REFRESH_TOKEN=
